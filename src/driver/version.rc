// Shared VERSIONINFO; define VER_DESCRIPTION and VER_FILENAME before including.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR, VER_MINOR, VER_BUILD, VER_REV
 PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_BUILD, VER_REV
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "relbp810 project"
            VALUE "FileDescription", VER_DESCRIPTION
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", VER_FILENAME
            VALUE "LegalCopyright", "Copyright (c) 2026 relbp810 contributors. MIT License."
            VALUE "OriginalFilename", VER_FILENAME
            VALUE "ProductName", "relbp810: Canon LBP-810 driver for 64-bit Windows"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
